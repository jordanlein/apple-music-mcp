{
  "name": "apple-music-mcp-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.toml --local --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply apple-music-mcp-local --local --config wrangler.local.toml",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/sites.ts --bundle --platform=browser --format=esm --outfile=dist/server/index.js"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.153.0"
  }
}
