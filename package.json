{
  "name": "apple-music-mcp-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.toml --local --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply apple-music-mcp-local --local --config wrangler.local.toml",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.1"
  }
}
